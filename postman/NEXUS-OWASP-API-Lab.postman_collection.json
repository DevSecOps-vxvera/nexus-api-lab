  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "demoToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "secureToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "secureRefresh",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 — Reiniciar fixtures",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/lab/reset",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "API1 — BOLA",
      "item": [
        {
          "name": "Login Carlos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"carlos\",\n  \"password\": \"demo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('demoToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Vulnerable — leer factura de María",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demoToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/invoices/1042",
            "description": ""
          }
        },
        {
          "name": "Login seguro — Carlos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/secure/v1/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"carlos\",\n  \"password\": \"demo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('secureToken', pm.response.json().accessToken); pm.collectionVariables.set('secureRefresh', pm.response.json().refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Seguro — misma factura de otro tenant (espera 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{secureToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/secure/v1/invoices/1042",
            "description": ""
          }
        }
      ]
    },
